# Entorno de pruebas: Vitest y Playwright arrancan en modo test y este archivo
# tiene prioridad sobre .env.local. Sin proyecto de Supabase y sólo con el catálogo
# sintético, las pruebas nunca leen ni escriben datos reales.
# Se versiona: no pongas aquí URLs, claves ni datos del negocio.
VITE_DATA_MODE=demo
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
